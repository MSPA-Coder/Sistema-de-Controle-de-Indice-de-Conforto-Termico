# Configuração opcional para execução local sem Docker.
# Copie para ".env". O ICT não edita este arquivo.
#
# Parâmetros operacionais alteráveis pelas abas (zonas, Modbus, intervalos,
# limites e alertas) são persistidos no banco e lidos pelo coletor.

# O ICT local usa este endereço para alcançar o coletor local.
# No Docker Compose, COLETOR_URL é fixado como http://coletor:5000.
COLETOR_URL=http://127.0.0.1:5001

# Fallback SMTP quando os campos correspondentes do banco estiverem vazios.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
