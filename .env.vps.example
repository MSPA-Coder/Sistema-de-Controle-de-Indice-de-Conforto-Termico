# Linha de base do que a PRODUÇÃO deve conter. `deploy.sh` lê exatamente este
# nome de arquivo (`.env.vps`) no servidor -- mesma convenção dos três
# projetos irmãos desde 01/09/2026 (ver CT-02 em
# docs/security-audit/achados-estado-final.json). Até ali este era o único dos
# quatro em que a produção lia `.env.docker`, o MESMO nome do arquivo de
# desenvolvimento local (`.env.docker.example`) — copiar o arquivo local para
# o servidor por engano, uma operação que parecia certa porque o nome batia,
# desligava `Secure` do cookie de sessão em silêncio.
#
# Não confundir com `.env.docker.example`, que é a linha de base LOCAL. Os dois
# trazem `CONFORTO_COOKIE_SEGURO=1`, e por motivos diferentes: em produção
# porque o cookie sai pela internet; localmente porque o Compose fixa
# `CONFORTO_HOST: 0.0.0.0` (obrigatório em contêiner) e
# `app_factory._validar_transporte` recusa a inicialização com o cookie
# inseguro fora de host de loopback.
#
# CORRIGIDO EM 08/09/2026. Este comentário afirmava que `0` estava certo
# localmente, "porque em desenvolvimento se serve por http e um cookie `Secure`
# simplesmente não viaja". As duas metades estavam erradas: navegador trata
# `127.0.0.1` como origem confiável e envia cookie `Secure` em http ali; e,
# desde a guarda de 02/09, com `0` o `ict` nem sobe. A afirmação sobreviveu
# porque a CI roda só o `quality`, que não levanta o `ict`, e a pilha local de
# quem desenvolve continuava numa imagem anterior à guarda -- `docker compose
# up -d` sem `--build` reaproveita a imagem existente.
#
# Conferido no VPS em 2026-08-21: a produção está correta. Este arquivo
# preserva isso.
#
# Segredos NÃO entram aqui. Senha do Postgres e chave de sessão são arquivos
# gerados por `python scripts/configurar_segredos.py` e montados pelo Compose.

POSTGRES_DB=conforto_termico
POSTGRES_USER=conforto
POSTGRES_PORT=5402
APP_PORT=5401

CONFORTO_SESSION_COOKIE_NAME=conforto_session

# `1` em produção: o cookie de sessão só viaja por https.
CONFORTO_COOKIE_SEGURO=1

CONFORTO_DEBUG=0

# Só ligar onde existe de fato um proxy à frente terminando o TLS — aqui, o
# nginx do VPS. Ligado sem proxy, qualquer cliente forja `X-Forwarded-For`,
# vira um IP novo a cada requisição, escapa do limitador de taxa por completo e
# ainda escolhe o endereço que vai aparecer no log de auditoria. É por isso que
# a variável existe em vez de o `ProxyFix` ser incondicional.
CONFORTO_TRUST_PROXY_HEADERS=true

# Senha do servidor SMTP (CT-03) -- opcional: sem ela, o alerta por e-mail
# opera em modo simulado (host/porta/usuário continuam editáveis pela tela,
# só a senha saiu de lá). Preencher só se o alerta por e-mail for usado de
# verdade nesta instância; ver docs/RUNBOOK.md para rotação.
SMTP_PASS=
