# Copie este arquivo para .env.docker e troque a senha se a porta do
# PostgreSQL for exposta além deste computador. O Compose publica as portas
# somente em 127.0.0.1 por padrão.
POSTGRES_DB=conforto_termico
POSTGRES_USER=conforto
POSTGRES_PASSWORD=conforto_dev_local
POSTGRES_PORT=5432
APP_PORT=5000
CONFORTO_DEBUG=0
# Gere um valor longo e aleatorio; deve ser igual no ICT e no coletor.
CONFORTO_INTERNO_TOKEN=troque-por-um-segredo-longo-e-aleatorio
