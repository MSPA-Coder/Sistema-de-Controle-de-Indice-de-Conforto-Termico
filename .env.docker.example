# Gere primeiro os arquivos de segredo com:
#   python scripts/configurar_segredos.py
# O Compose publica as portas somente em 127.0.0.1 por padrão.
POSTGRES_DB=conforto_termico
POSTGRES_USER=conforto
POSTGRES_PORT=5002
APP_PORT=5001
CONFORTO_SESSION_COOKIE_NAME=conforto_session
# `1` mesmo em desenvolvimento. O Compose fixa `CONFORTO_HOST: 0.0.0.0`, sem
# alternativa em contêiner, e `_validar_transporte` recusa subir assim com o
# cookie inseguro. O `Secure` não atrapalha: navegador trata `127.0.0.1` como
# origem confiável e envia o cookie normalmente em http ali.
CONFORTO_COOKIE_SEGURO=1
CONFORTO_DEBUG=0

# Senha do servidor SMTP (CT-03) -- opcional: sem ela, o alerta por e-mail
# opera em modo simulado. Host/porta/usuário continuam editáveis pela tela;
# a senha NUNCA fica no banco. Deixe em branco em desenvolvimento.
SMTP_PASS=
